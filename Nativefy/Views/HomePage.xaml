<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Nativefy.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Nativefy.Views"
    xmlns:local="using:Nativefy"
    xmlns:controls="using:Nativefy.Controls"
    xmlns:toolkitcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:Nativefy.Engine"
    xmlns:helpers="using:Nativefy.Helpers">

    <Grid>
        <TextBlock 
            HorizontalAlignment="Center" 
            VerticalAlignment="Center"
            Text="Please search for something to enable the home feed" 
            FontSize="20" 
            Visibility="{x:Bind ViewModel.IsFeedEmpty, Mode=OneWay}"/>

        <ScrollViewer Visibility="{x:Bind ViewModel.IsFeedNotEmpty, Mode=OneWay}">
            <Grid Padding="25" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- User greeting section -->
                <controls:HomeHeader
                    IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    FilterChecked="OnFilterRadioButtonClick" />

                <!-- Hero Section -->
                <Grid 
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch"
                    RowSpacing="10"
                    ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <toolkitcontrols:Shimmer 
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                        Height="3"
                        HorizontalAlignment="Left"
                        CornerRadius="2" 
                        Width="200" />

                    <Border 
                        Visibility="{x:Bind ViewModel.IsNotLoading, Mode=OneWay}"
                        BorderThickness="2" 
                        BorderBrush="{ThemeResource SystemAccentColor}" 
                        Width="200" 
                        CornerRadius="2" 
                        HorizontalAlignment="Left" />

                    <!-- Banner Slide show -->
                    <controls:AmbientImageViewer 
                        IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" 
                        ItemsSource="{x:Bind ViewModel.HeroAdapter.HeroSlides, Mode=OneWay}"
                        ImagesCount="{x:Bind ViewModel.HeroAdapter.HeroSlides.Count, Mode=OneWay}" />

                    <!-- Shortcuts Side pane -->
                    <controls:HeroSidePane 
                        Grid.Column="1" 
                        Grid.Row="1" 
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.HeroAdapter.Cards, Mode=OneWay}"
                        IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}" 
                        ItemInvoked="Play_Clicked"/>
                </Grid>

                <Grid Grid.Row="3" HorizontalAlignment="Center">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Feed, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                Orientation="Horizontal"
                                MinItemWidth="350"
                                MinItemHeight="300"
                                MinColumnSpacing="5"
                                MinRowSpacing="5" />
                        </ItemsRepeater.Layout>

                        <DataTemplate x:DataType="models:FeedResult">
                            <Button Padding="10" Click="Play_Clicked" Tag="{x:Bind Id}">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Image Source="{x:Bind ImageUrl}" />
                                        <Border 
                                            VerticalAlignment="Bottom" 
                                            HorizontalAlignment="Left" 
                                            Background="Black"
                                            Margin="5"
                                            Padding="2, 0" CornerRadius="4">
                                            <TextBlock Text="{x:Bind helpers:DurationHelper.FormatDuration(Duration)}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" FontSize="16" />
                                        <TextBlock Text="{x:Bind Author}" FontSize="14" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Nativefy.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nativefy.Views"
    xmlns:models="using:Nativefy.Engine"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Grid Padding="16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <TextBlock x:Name="QueryPreview" FontSize="40" />

        <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <toolkit:Shimmer Height="30" Width="50"/>
                <toolkit:Shimmer Height="30" Width="50"/>
                <toolkit:Shimmer Height="30" Width="50"/>
            </StackPanel>
            
            <ScrollViewer Padding="8" Grid.Row="2">
                <ItemsView IsItemInvokedEnabled="False" SelectionMode="None" ItemsSource="{x:Bind ViewModel.DummyResults, Mode=OneWay}">
                    <ItemsView.ItemTemplate>
                        <DataTemplate>
                            <ItemContainer>
                                <Grid ColumnSpacing="8" Height="80" Padding="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="120" CornerRadius="6">
                                        <Grid>
                                            <toolkit:Shimmer HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                                            <toolkit:Shimmer 
                                                Padding="2" Margin="6" CornerRadius="8"
                                                HorizontalAlignment="Right" 
                                                VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <toolkit:Shimmer HorizontalAlignment="Left" FontSize="18" Width="600" Height="20"/>
                                        <toolkit:Shimmer HorizontalAlignment="Left" Width="300" />
                                        <toolkit:Shimmer HorizontalAlignment="Left" Width="100" />
                                    </StackPanel>
                                </Grid>
                            </ItemContainer>
                        </DataTemplate>
                    </ItemsView.ItemTemplate>
                </ItemsView>
            </ScrollViewer>
        </Grid>
        
        <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.IsNotLoading, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <NavigationView 
                Grid.Row="1" 
                IsSettingsVisible="False"
                IsBackButtonVisible="Collapsed"
                PaneDisplayMode="Top"
                SelectionChanged="Filter_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="All" IsSelected="True" />
                    <NavigationViewItem Content="Not watched yet" IsEnabled="False" />
                    <NavigationViewItem Content="Liked" IsEnabled="False" />
                </NavigationView.MenuItems>
            </NavigationView>

            <ScrollViewer Padding="8" Grid.Row="2">
                <ItemsView 
                    SelectionMode="None"
                    IsItemInvokedEnabled="True"
                    ItemInvoked="Result_ItemInvoked"
                    ItemsSource="{x:Bind ViewModel.Results}">
                    <ItemsView.ItemTemplate>
                        <DataTemplate x:DataType="models:IPlayable">
                            <ItemContainer>
                                <Grid ColumnSpacing="8" Height="80" Padding="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="120" CornerRadius="6">
                                        <Grid>
                                            <Image Source="{x:Bind ImageUrl}" VerticalAlignment="Center" />

                                            <!-- <Border 
                                                Padding="2" CornerRadius="8"
                                                HorizontalAlignment="Right" 
                                                VerticalAlignment="Bottom"
                                                Background="#801A1A1A">
                                                <TextBlock 
                                                    FontSize="12"
                                                    Text="{x:Bind local:SearchPage.FormatDuration(Duration)}" 
                                                    Foreground="{ThemeResource TextFillColorSecondary}"/>
                                            </Border> -->
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Title}" FontSize="18" />
                                        <TextBlock Text="{x:Bind Author}" Foreground="{ThemeResource TextFillColorSecondary}"/>
                                    </StackPanel>

                                    <Button 
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Click="Like_Click"
                                        Tag="{x:Bind Url}"
                                        Style="{StaticResource HeartHoverButtonStyle}"/>
                                </Grid>
                            </ItemContainer>
                        </DataTemplate>
                    </ItemsView.ItemTemplate>
                </ItemsView>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

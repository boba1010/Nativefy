<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Nativefy.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nativefy.Views"
    xmlns:models="using:Nativefy.Engine">

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="QueryPreview" FontSize="40" />

        <NavigationView Grid.Row="1" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" PaneDisplayMode="Top">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="All" IsSelected="True" />
                <NavigationViewItem Content="Not watched yet" />
            </NavigationView.MenuItems>
        </NavigationView>

        <ScrollViewer Padding="8" Grid.Row="2">
            <ItemsView 
                SelectionMode="None"
                IsItemInvokedEnabled="True"
                ItemInvoked="Result_ItemInvoked"
                ItemsSource="{x:Bind ViewModel.Results}">
                <ItemsView.ItemTemplate>
                    <DataTemplate x:DataType="models:IPlayableItem">
                        <ItemContainer>
                            <Grid ColumnSpacing="8" Height="80" Padding="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <Border Width="120" CornerRadius="6">
                                    <Grid>
                                        <Image Source="{x:Bind ImageUrl}" VerticalAlignment="Center" />

                                        <Border 
                                            Padding="2" CornerRadius="8"
                                            HorizontalAlignment="Right" 
                                            VerticalAlignment="Bottom"
                                            Background="#801A1A1A">
                                            <TextBlock 
                                                FontSize="12"
                                                Text="{x:Bind local:SearchPage.FormatDuration(Duration)}" 
                                                Foreground="{ThemeResource TextFillColorSecondary}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Title}" FontSize="18" />
                                    <TextBlock Text="{x:Bind Author}" Foreground="{ThemeResource TextFillColorSecondary}"/>
                                </StackPanel>
                                
                                <Button 
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Click="Like_Click"
                                    Style="{StaticResource HeartHoverButtonStyle}"/>
                            </Grid>
                        </ItemContainer>
                    </DataTemplate>
                </ItemsView.ItemTemplate>
            </ItemsView>            
        </ScrollViewer>
    </Grid>
</Page>

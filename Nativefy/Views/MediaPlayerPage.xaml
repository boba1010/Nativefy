<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Nativefy.Views.MediaPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nativefy.Views" 
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows">

    <Grid>
        <vlc:VideoView
            x:Name="VideoView"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Initialized="VideoView_Initialized" />

        <Grid Background="Transparent" PointerReleased="Surface_PointerReleased" />
    </Grid>
</Page>

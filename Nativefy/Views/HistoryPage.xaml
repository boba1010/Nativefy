<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Nativefy.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nativefy.Views"
    xmlns:root="using:Nativefy"
    xmlns:models="using:Nativefy.Models.Media"
    xmlns:helpers="using:Nativefy.Helpers">

    <Page.Resources>
        <Style x:Key="PillRadioButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="MediaTemplate" x:DataType="models:HistoryMediaItem">
            <ItemContainer>
                <Grid ColumnSpacing="8" Height="80" Padding="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="120" CornerRadius="6">
                        <Grid>
                            <Image Source="{x:Bind ImageUrl}" VerticalAlignment="Center" />

                            <Border 
                                Padding="2" CornerRadius="2"
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Bottom"
                                Background="Black">
                                <TextBlock 
                                    FontSize="12"
                                    Text="{x:Bind helpers:DurationHelper.FormatDuration(Duration)}" 
                                    Foreground="{ThemeResource TextFillColorSecondary}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Bind Title}" FontSize="18" />
                        <TextBlock Text="{x:Bind Author}" Foreground="{ThemeResource TextFillColorSecondary}"/>
                    </StackPanel>

                    <Button 
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="Like_Click"
                        Tag="{x:Bind Id}"
                        Style="{StaticResource HeartHoverButtonStyle}"/>
                </Grid>
            </ItemContainer>
        </DataTemplate>

        <DataTemplate x:Key="PlaylistTemplate" x:DataType="models:HistoryPlaylist">
            <ItemContainer>
                <Grid ColumnSpacing="8" Height="80" Padding="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="120" CornerRadius="6">
                        <Grid>
                            <Image Source="{x:Bind ImageUrl}" VerticalAlignment="Center" />

                            <Border 
                                Padding="2" CornerRadius="2"
                                Height="20" Width="20"
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Bottom"
                                Background="#801A1A1A">
                                <FontIcon Glyph="&#xE768;" FontSize="12"/>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Bind Title}" FontSize="18" />
                        <TextBlock Text="{x:Bind Author}" Foreground="{ThemeResource TextFillColorSecondary}"/>
                    </StackPanel>

                    <Button 
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="Like_Click"
                        Tag="{x:Bind Id}"
                        Style="{StaticResource HeartHoverButtonStyle}"/>
                </Grid>
            </ItemContainer>
        </DataTemplate>
        
        <DataTemplate x:Key="SearchTemplate" x:DataType="models:SearchHistory">
            <ItemContainer>
                <Grid ColumnSpacing="8" Height="80" Padding="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="120" CornerRadius="6">
                        <SymbolIcon Symbol="Find" />
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Bind Query}" FontSize="18" />
                        <TextBlock 
                            Text="{x:Bind helpers:DatetimeHelper.FormatToEnglish(UpdatedAt)}" 
                            Foreground="{ThemeResource TextFillColorSecondary}"/>
                    </StackPanel>
                </Grid>
            </ItemContainer>
        </DataTemplate>

        <root:HistoryTemplateSelector 
            x:Key="HistoryTemplateSelector"
            MediaTemplate="{StaticResource MediaTemplate}"
            PlaylistTemplate="{StaticResource PlaylistTemplate}"
            SearchTemplate="{StaticResource SearchTemplate}" />
    </Page.Resources>
    
    <Grid Padding="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <StackPanel Orientation="Horizontal" Spacing="10">
            <RadioButton 
                Content="All" 
                GroupName="Filter" 
                Style="{StaticResource PillRadioButtonStyle}" 
                Height="40" Tag="All"
                IsChecked="True" 
                Checked="OnRadioFilterButtonChecked"/>
            
            <RadioButton
                Content="Videos" 
                GroupName="Filter" 
                Style="{StaticResource PillRadioButtonStyle}" 
                Height="40" Tag="Videos"
                Checked="OnRadioFilterButtonChecked"/>
            
            <RadioButton 
                Height="40" Tag="Playlists"
                Content="Playlists"
                Style="{StaticResource PillRadioButtonStyle}" 
                GroupName="Filter" 
                Checked="OnRadioFilterButtonChecked"/>
            
            <RadioButton 
                Height="40" Tag="Searches"
                Content="Searches"
                Style="{StaticResource PillRadioButtonStyle}" 
                GroupName="Filter" 
                Checked="OnRadioFilterButtonChecked"/>
        </StackPanel>

        <ScrollViewer Padding="8" Grid.Row="2">
            <ItemsView 
                SelectionMode="None"
                IsItemInvokedEnabled="True"
                ItemInvoked="History_ItemInvoked"
                ItemsSource="{x:Bind ViewModel.FilteredHistory, Mode=OneWay}"
                ItemTemplate="{StaticResource HistoryTemplateSelector}" />
        </ScrollViewer>
    </Grid>
</Page>

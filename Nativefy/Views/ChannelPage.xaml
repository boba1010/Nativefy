<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Nativefy.Views.ChannelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nativefy.Views"
    xmlns:models="using:Nativefy.Models.Media" 
    xmlns:helpers="using:Nativefy.Helpers"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:root="using:Nativefy">

    <Page.Resources>
        <root:BoolToStringConvertor x:Name="BoolToString" />
    </Page.Resources>
    
    <Grid>
        <Grid Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" RowSpacing="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border HorizontalAlignment="Left" Margin="0, 80, 0, 0" Padding="30, 0">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border CornerRadius="80">
                        <controls:Shimmer Width="128" Height="128" />
                    </Border>

                    <controls:Shimmer Grid.Column="1" VerticalAlignment="Top" Margin="0, 20, 0, 0" Width="300" Height="30" />

                    <controls:Shimmer 
                        Grid.Column="1" 
                        Height="30" Width="100" 
                        Margin="0, 0, 0, 20" 
                        VerticalAlignment="Bottom" 
                        HorizontalAlignment="Left"
                        CornerRadius="12" />
                </Grid>
            </Border>

            <ScrollViewer HorizontalAlignment="Center" Padding="15, 0" Grid.Row="1">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.DummyVideos, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            Orientation="Horizontal"
                            MinItemWidth="350"
                            MinItemHeight="300"
                            MinColumnSpacing="5"
                            MinRowSpacing="5" />
                    </ItemsRepeater.Layout>

                    <DataTemplate>
                        <Button Padding="10">
                            <Grid Width="320" RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <controls:Shimmer Height="200" VerticalAlignment="Top" HorizontalAlignment="Stretch" />
                                    <controls:Shimmer
                                        VerticalAlignment="Bottom" 
                                        HorizontalAlignment="Left"
                                        Margin="5"
                                        Height="10"
                                        Padding="2" CornerRadius="4" />
                                </Grid>

                                <StackPanel Grid.Row="1" Spacing="5">
                                    <controls:Shimmer Height="20" Width="300" HorizontalAlignment="Left" FontSize="16" />
                                    <controls:Shimmer Height="10" HorizontalAlignment="Left" Width="100" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <Grid Padding="15" RowSpacing="30" Visibility="{x:Bind ViewModel.IsNotLoading, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border HorizontalAlignment="Left" Padding="30, 0">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <PersonPicture Width="128" Height="128">
                        <PersonPicture.ProfilePicture>
                            <BitmapImage UriSource="{x:Bind ViewModel.ImageUrl, Mode=OneWay}" DecodePixelWidth="128" />
                        </PersonPicture.ProfilePicture>
                    </PersonPicture>

                    <TextBlock Grid.Column="1" VerticalAlignment="Top" Margin="0, 20, 0, 0" FontSize="25" Text="{x:Bind ViewModel.Title, Mode=OneWay}" />

                    <Button 
                        Grid.Column="1" 
                        Content="{x:Bind ViewModel.IsChannelLiked, Mode=OneWay, Converter={StaticResource BoolToString}}" 
                        Margin="0, 0, 0, 20" Width="100" 
                        VerticalAlignment="Bottom" 
                        CornerRadius="12" 
                        Command="{x:Bind ViewModel.ToggleLikeChannelCommand}" />
                </Grid>
            </Border>

            <ItemsRepeaterScrollHost HorizontalAlignment="Center" Grid.Row="1">
                <ScrollViewer>
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                    
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Videos}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    Orientation="Horizontal"
                                    MinItemWidth="350"
                                    MinItemHeight="270"
                                    MinColumnSpacing="8"
                                    MinRowSpacing="8" />
                            </ItemsRepeater.Layout>

                            <DataTemplate x:DataType="models:MediaItem">
                                <Button 
                                    Width="350" Height="270"
                                    VerticalAlignment="Stretch" 
                                    HorizontalAlignment="Stretch" 
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Tag="{x:Bind Id}" Padding="10"
                                    Click="Play_Clicked">
                                    <Grid RowSpacing="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="191" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid VerticalAlignment="Stretch">
                                            <Border>
                                                <Image
                                                    Stretch="UniformToFill" 
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" 
                                                    Source="{x:Bind ImageUrl}" />
                                            </Border>

                                            <Border 
                                                VerticalAlignment="Bottom" 
                                                HorizontalAlignment="Left" 
                                                Background="Black"
                                                Margin="5"
                                                Padding="2, 0" CornerRadius="4">
                                                <TextBlock Text="{x:Bind helpers:DurationHelper.FormatDuration(Duration)}" />
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Row="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" FontSize="16" />
                                            <TextBlock Text="{x:Bind Author}" FontSize="14" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater>

                        <Button Command="{x:Bind ViewModel.LoadMoreCommand}" Grid.Row="1" HorizontalAlignment="Stretch" Content="More" />
                    </Grid>
                </ScrollViewer>                
            </ItemsRepeaterScrollHost>
        </Grid>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Nativefy.Views.ChannelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nativefy.Views"
    xmlns:models="using:Nativefy.Models.Media" 
    xmlns:helpers="using:Nativefy.Helpers"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:root="using:Nativefy"
    xmlns:channels="using:Nativefy.Engine.Channels"
    xmlns:convertors="using:Nativefy.Convertors"
    xmlns:channelscontrols="using:Nativefy.Controls">

    <Page.Resources>
        <root:BoolToStringConvertor x:Name="BoolToString" />
    </Page.Resources>

    <ItemsRepeaterScrollHost HorizontalAlignment="Center" Grid.Row="2">
        <ScrollViewer x:Name="ChannelScrollViewer">
            <Grid>
                <Grid Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" RowSpacing="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border HorizontalAlignment="Left" Margin="0, 80, 0, 0" Padding="30, 0">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border CornerRadius="80">
                                <controls:Shimmer Width="128" Height="128" />
                            </Border>

                            <controls:Shimmer Grid.Column="1" VerticalAlignment="Top" Margin="0, 20, 0, 0" Width="300" Height="30" />

                            <controls:Shimmer 
                                Grid.Column="1" 
                                Height="30" Width="100" 
                                Margin="0, 0, 0, 20" 
                                VerticalAlignment="Bottom" 
                                HorizontalAlignment="Left"
                                CornerRadius="12" />
                        </Grid>
                    </Border>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.DummyVideos, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                Orientation="Horizontal"
                                MinItemWidth="350"
                                MinItemHeight="300"
                                MinColumnSpacing="5"
                                MinRowSpacing="5" />
                        </ItemsRepeater.Layout>

                        <DataTemplate>
                            <Button Padding="10">
                                <Grid Width="320" RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <controls:Shimmer Height="200" VerticalAlignment="Top" HorizontalAlignment="Stretch" />
                                        <controls:Shimmer
                                            VerticalAlignment="Bottom" 
                                            HorizontalAlignment="Left"
                                            Margin="5"
                                            Height="10"
                                            Padding="2" CornerRadius="4" />
                                    </Grid>

                                    <StackPanel Grid.Row="1" Spacing="5">
                                        <controls:Shimmer Height="20" Width="300" HorizontalAlignment="Left" FontSize="16" />
                                        <controls:Shimmer Height="10" HorizontalAlignment="Left" Width="100" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater>
                </Grid>

                <Grid Padding="15" RowSpacing="30" Visibility="{x:Bind ViewModel.IsNotLoading, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border HorizontalAlignment="Left" Padding="30, 0">
                        <Grid RowSpacing="15" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border 
                                Grid.ColumnSpan="2" 
                                CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorDefault}" 
                                HorizontalAlignment="Stretch">
                                <Image Source="{x:Bind ViewModel.BannerUrl, Mode=OneWay}" />
                            </Border>

                            <PersonPicture Grid.Row="1" Width="128" Height="128" ProfilePicture="{x:Bind ViewModel.ImageUrl, Mode=OneWay}" />

                            <StackPanel Spacing="5" Grid.Row="1" Grid.Column="1">
                                <TextBlock
                                    ToolTipService.ToolTip="{x:Bind ViewModel.Title, Mode=OneWay}"
                                    VerticalAlignment="Top" 
                                    Margin="0, 20, 0, 0" 
                                    FontSize="30"
                                    FontWeight="Bold"
                                    Text="{x:Bind ViewModel.Title, Mode=OneWay}" />

                                <TextBlock>
                                    <Run FontWeight="Bold" Text="{x:Bind ViewModel.Handle, Mode=OneWay}" />
                                    <Run Text="•" />
                                    <Run Text="{x:Bind ViewModel.Subscribers, Mode=OneWay}" />
                                    <Run Text="•" />
                                    <Run Text="{x:Bind ViewModel.VideoCount, Mode=OneWay}" />
                                </TextBlock>

                                <Button 
                                    Click="Description_Click"
                                    Width="600" Padding="5"
                                    HorizontalContentAlignment="Stretch" 
                                    Background="Transparent" 
                                    BorderThickness="0"
                                    Tag="{x:Bind ViewModel.Description, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                </Button>

                                <Button 
                                    Content="{x:Bind ViewModel.IsChannelLiked, Mode=OneWay, Converter={StaticResource BoolToString}}" 
                                    Margin="0, 0, 0, 20" Width="80" 
                                    VerticalAlignment="Bottom" 
                                    CornerRadius="12" 
                                    Command="{x:Bind ViewModel.ToggleLikeChannelCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="8" />
                        </ItemsRepeater.Layout>

                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="channels:ChannelTab">
                                <RadioButton
                                    Height="40"
                                    Content="{x:Bind Title}"
                                    IsChecked="{x:Bind IsSelected}"
                                    Checked="Tab_Changed"
                                    Tag="{x:Bind}"
                                    Style="{StaticResource PillRadioButtonStyle}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <Grid RowSpacing="15" HorizontalAlignment="Stretch" Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <channelscontrols:ChannelVideosView 
                            PlayClick="Play_Clicked"
                            Tab="{x:Bind ViewModel.Tab, Mode=OneWay}"
                            Videos="{x:Bind ViewModel.Videos, Mode=OneWay}" />

                        <channelscontrols:ChannelHomeView 
                            Tab="{x:Bind ViewModel.Tab, Mode=OneWay}" 
                            Shelves="{x:Bind ViewModel.Shelves, Mode=OneWay}" />

                        <Button
                            Command="{x:Bind ViewModel.LoadMoreCommand}" 
                            Grid.Row="1" Content="More"
                            HorizontalAlignment="Stretch"
                            Visibility="{x:Bind ViewModel.CanLoadMore, Mode=OneWay}" />

                        <ProgressRing 
                            IsIndeterminate="True"
                            Visibility="{x:Bind ViewModel.IsMoreLoading, Mode=OneWay}" 
                            Grid.Row="1"
                            HorizontalAlignment="Center" 
                            Width="64" Height="64" />
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </ItemsRepeaterScrollHost>
</Page>

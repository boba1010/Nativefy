<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Nativefy.Controls.NewPlaylistDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nativefy.Controls"
    Style="{ThemeResource DefaultContentDialogStyle}"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    SecondaryButtonClick="ContentDialog_SecondaryButtonClick">

    <StackPanel Spacing="10">
        <TextBox x:Name="PlaylistNameBox" PlaceholderText="Enter playlist name" />
        <TextBox x:Name="PlaylistCoverUrlBox" PlaceholderText="Enter playlist cover image url (optional)" />
    </StackPanel>
</ContentDialog>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nativefy.Controls.FilterCollections"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nativefy.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:homemodels="using:Nativefy.Models.Home"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Grid>
        <Grid 
            Visibility="{x:Bind IsLoading, Mode=OneWay}"
            Grid.Row="4" 
            RowSpacing="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:Shimmer
                Width="300"
                Height="50"
                HorizontalAlignment="Left"/>

            <ItemsRepeater
                Grid.Row="1"
                ItemsSource="{x:Bind FilterCollectionsSource, Mode=OneWay}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="homemodels:BrowseAllGroup">
                        <StackPanel>
                            <controls:Shimmer HorizontalAlignment="Left" Width="80" Height="15" />

                            <GridView 
                                x:Name="FilterMatrixGrid"
                                ItemsSource="{x:Bind Items}"
                                SelectionMode="None">

                                <GridView.ItemTemplate>
                                    <DataTemplate>
                                        <controls:Shimmer Padding="12,8" Width="150" Height="30" CornerRadius="6"/>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </Grid>       
        
        <Grid 
            Visibility="{x:Bind IsNotLoading, Mode=OneWay}"
            Grid.Row="4" 
            RowSpacing="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock FontSize="30" FontWeight="Bold" Text="Browse All"/>

            <ItemsRepeater
                Grid.Row="1"
                ItemsSource="{x:Bind FilterCollectionsSource, Mode=OneWay}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="homemodels:BrowseAllGroup">
                        <StackPanel>
                            <TextBlock 
                                FontSize="10"
                                Foreground="Gray"
                                Text="{x:Bind Eyebrow}" />

                            <GridView 
                                x:Name="FilterMatrixGrid"
                                ItemsSource="{x:Bind Items}"
                                SelectionMode="None">

                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="homemodels:BrowseAllItem">
                                        <Button 
                                            Content="{x:Bind Label}"
                                            Tag="{x:Bind Uri}"
                                            CommandParameter="{x:Bind Uri}"
                                            BorderThickness="0"
                                            Padding="12,8"
                                            Width="150"
                                            HorizontalContentAlignment="Left"
                                            CornerRadius="6"
                                            Foreground="White"
                                            Click="OnFilterButtonClick">
                                            <Button.Resources>
                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{x:Bind AccentHex}" />
                                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{x:Bind AccentHex}" />

                                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="LightGray" />
                                            </Button.Resources>
                                        </Button>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </Grid>        
    </Grid>
</UserControl>

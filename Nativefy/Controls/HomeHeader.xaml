<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nativefy.Controls.HomeHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nativefy.Controls"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <Style x:Key="PillRadioButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment"    Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid VerticalAlignment="Top">
        <StackPanel 
            Orientation="Horizontal"
            Spacing="10"
            Visibility="{x:Bind IsLoading, Mode=OneWay}">
            <controls:Shimmer 
                Width="60"
                Height="40"
                Padding="0"
                CornerRadius="20"/>
            <controls:Shimmer  
                Width="60"
                Height="40"
                Padding="0"
                CornerRadius="20"/>
            <controls:Shimmer 
                Width="60"
                Height="40"
                CornerRadius="20" />
        </StackPanel>

        <StackPanel 
            Visibility="{x:Bind IsNotLoading, Mode=OneWay}"
            Orientation="Horizontal"
            Spacing="10">
            <RadioButton 
                Content="All" 
                GroupName="Filter" 
                Style="{StaticResource PillRadioButtonStyle}" 
                Width="40" Height="40"
                IsChecked="True" 
                Checked="OnRadioFilterButtonChecked"/>
            <!-- 
            <RadioButton
                Content="Music" 
                GroupName="Filter" 
                Style="{StaticResource PillRadioButtonStyle}" 
                Width="60"
                Height="40"
                Checked="OnRadioFilterButtonChecked"/>
            <RadioButton 
                Height="40"
                Content="Podcasts"
                Style="{StaticResource PillRadioButtonStyle}" 
                GroupName="Filter" 
                Checked="OnRadioFilterButtonChecked"/> 
            -->
        </StackPanel>
    </Grid>
</UserControl>

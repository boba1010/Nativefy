<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nativefy.Controls.LibraryNavigationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nativefy.Controls"
    xmlns:models="using:Nativefy.Models"
    xmlns:root="using:Nativefy">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="300" MinWidth="60"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ContentPresenter Grid.Row="0" Content="{x:Bind Header}"/>

            <!-- Scrollable List Framework -->
            <ScrollViewer Grid.Row="1" VerticalScrollMode="Auto" HorizontalScrollMode="Disabled">
                <ItemsControl x:Name="NavigationGroupsControl" ItemsSource="{x:Bind NavigationGroups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="12" Padding="8,4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SidebarGroup">
                            <StackPanel Spacing="2">

                                <!-- DYNAMIC GROUP HEADER TRIGGER / CONVERTS TO SEPARATOR -->
                                <Button 
                                    x:Name="GroupHeaderButton"
                                    Tag="{x:Bind GroupTag}"
                                    CornerRadius="4" BorderThickness="0" 
                                    Height="40" Padding="8,0"
                                    Background="Transparent" 
                                    HorizontalAlignment="Stretch" 
                                    HorizontalContentAlignment="Stretch" 
                                    Click="OnGroupHeaderClicked">
                                    <Grid>
                                        <!-- Full Nav View -->
                                        <Grid x:Name="HeaderFullContent">
                                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left">
                                                <SymbolIcon Symbol="Library"/>
                                                <TextBlock Text="{x:Bind HeaderText}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            
                                            <FontIcon 
                                                x:Name="GroupChevronGlyph"
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}" 
                                                Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="12"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Mini Separator View -->
                                        <Border 
                                            x:Name="HeaderSeparatorLine" 
                                            Height="1" 
                                            Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" 
                                            HorizontalAlignment="Stretch" 
                                            VerticalAlignment="Center" 
                                            Margin="8,0"
                                            Visibility="Collapsed"/>
                                    </Grid>
                                </Button>

                                <Button 
                                    Command="{x:Bind CompactCommand}" 
                                    Visibility="Collapsed" 
                                    x:Name="HeaderCompactContent">
                                    <FontIcon Glyph="{x:Bind CompactGlyph, Mode=OneWay}" FontSize="14"/>
                                </Button>

                                <!-- INNER SUBMENU ITEMS CONTAINER -->
                                <ItemsControl x:Name="GroupItemsControl" ItemsSource="{x:Bind Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:SidebarMenuItem">
                                            <Button Tag="{x:Bind Tag}" BorderThickness="0" Background="Transparent" Click="OnSubmenuItemClicked" Height="36" CornerRadius="4" HorizontalAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <FontIcon 
                                                        Glyph="{x:Bind Glyph}" Visibility="{x:Bind HasGlyph}"
                                                        VerticalAlignment="Center"/>
                                                    
                                                    <Border CornerRadius="4" Visibility="{x:Bind HasImage}">
                                                        <Image Source="{x:Bind ImageUrl}" />                                                        
                                                    </Border>
                                                    
                                                    <TextBlock 
                                                        x:Name="ItemText" 
                                                        Text="{x:Bind Text}" 
                                                        VerticalAlignment="Center" 
                                                        Loaded="OnItemTextLoaded"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Custom Resize Grip Border -->
            <Border
                x:Name="resizeGrip"
                Width="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="Transparent"
                PointerPressed="ResizeGrip_PointerPressed"
                PointerMoved="ResizeGrip_PointerMoved"
                PointerReleased="ResizeGrip_PointerReleased"
                PointerEntered="ResizeGrip_PointerEntered"
                PointerExited="ResizeGrip_PointerExited"
                Canvas.ZIndex="100"/>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ContentPresenter
                Grid.Column="1" CornerRadius="12 0 0 0"
                Background="{ThemeResource LayerOnAcrylicFillColorDefault}"
                Content="{x:Bind InnerContent}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>
        </Grid>
    </Grid>
</UserControl>

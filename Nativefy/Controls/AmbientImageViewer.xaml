<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nativefy.Controls.AmbientImageViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nativefy.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:Nativefy.Models"
    mc:Ignorable="d">

    <Grid>
        <Grid
            Height="400"
            Visibility="{x:Bind IsLoading, Mode=OneWay}">
            <controls:Shimmer
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"/>
            
            <StackPanel
                Padding="40"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                Spacing="10">
                <controls:Shimmer
                    Width="200"
                    Height="20"
                    HorizontalAlignment="Left"/>
                <controls:Shimmer
                    Width="400"
                    Height="40"
                    Margin="0, 10, 0, 0"
                    HorizontalAlignment="Left"/>
                <controls:Shimmer
                    Width="100"
                    Height="20"
                    HorizontalAlignment="Left"
                    Margin="0, 10, 0, 0"/>

                <StackPanel
                    Margin="0, 20, 0, 0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Spacing="8">
                    <controls:Shimmer
                        Width="80"
                        Height="30"/>
                    <controls:Shimmer
                        Width="80"
                        Height="30"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        
        <Grid
            Visibility="{x:Bind IsNotLoading, Mode=OneWay}"
            MaxHeight="500">
            <local:AmbientGlowBackdrop
                x:Name="glow"
                Margin="-40"
                BlurAmount="70"
                GlowScale="1.05"
                GlowOpacity="0.65" />

            <FlipView
                CornerRadius="12"
                x:Name="imageFlipView"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                ItemsSource="{x:Bind ItemsSource, Mode=OneWay}"
                Loaded="OnImageFlipViewLoaded"
                SelectionChanged="OnFlipViewSelectionChanged">

                <FlipView.ItemContainerStyle>
                    <Style TargetType="FlipViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    </Style>
                </FlipView.ItemContainerStyle>

                <FlipView.ItemTemplate>
                    <DataTemplate x:DataType="models:HeroCarouselItem">
                        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <local:ImageView 
                                ImageUrl="{x:Bind ImageUrl}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                                <local:ImageView.OverlayContent>
                                    <Grid 
                                        HorizontalAlignment="Left" 
                                        VerticalAlignment="Center" 
                                        Padding="40" RowSpacing="20">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border
                                            VerticalAlignment="Top"
                                            Padding="4" CornerRadius="6"
                                            Background="#A03c3c3c">
                                            <TextBlock Text="{x:Bind Eyebrow}" TextAlignment="Center" FontSize="13"/>                                            
                                        </Border>
                                        
                                        <TextBlock Grid.Row="1" Text="{x:Bind Title}" FontSize="50" FontWeight="Bold"/>
                                        
                                        <TextBlock Grid.Row="2" FontSize="15" Text="{x:Bind Tagline}" />

                                        <StackPanel Grid.Row="3" Spacing="10" Orientation="Horizontal">
                                            <Button 
                                                Background="{ThemeResource SystemAccentColorDark1}"
                                                Foreground="White"
                                                CornerRadius="6" 
                                                Padding="16,8"
                                                MinWidth="100"
                                                Tag="{x:Bind Tag}"
                                                Content="{x:Bind PrimaryCtaText}"
                                                Click="OnPlayButtonClick"
                                                CommandParameter="{x:Bind PrimaryCtaCommandParameter}"
                                                Command="{x:Bind PrimaryCtaCommand}">
                                                <Button.Resources>
                                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemAccentColor}" />

                                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemAccentColorDark2}" />

                                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="LightGray" />
                                                </Button.Resources>
                                            </Button>

                                            <Button
                                                Content="{x:Bind SecondaryCtaText}" 
                                                Foreground="White"
                                                CornerRadius="6" 
                                                Padding="16,8"
                                                MinWidth="100"
                                                Tag="{x:Bind Tag}"
                                                Background="#1AFFFFFF" 
                                                BorderThickness="1"
                                                CommandParameter="{x:Bind SecondaryCtaCommandParameter}"
                                                Command="{x:Bind SecondaryCtaCommand}"
                                                Click="OnOpenButtonClick">
                                                <Button.BorderBrush>
                                                    <SolidColorBrush Color="{ThemeResource SystemAccentColorLight3}" Opacity="0.2"/>
                                                </Button.BorderBrush>
                                                <Button.Resources>
                                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2AFFFFFF" />

                                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#5AFFFFFF" />

                                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="LightGray" />
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </local:ImageView.OverlayContent>
                            </local:ImageView>
                        </Border>
                    </DataTemplate>
                </FlipView.ItemTemplate>
            </FlipView>

            <PipsPager 
                x:Name="flipViewPipsPager"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0, 12, 0, 0"
                NumberOfPages="{x:Bind ImagesCount, Mode=OneWay}"
                SelectedPageIndex="{x:Bind Path=imageFlipView.SelectedIndex, Mode=TwoWay}"
                SelectedIndexChanged="MyPipsPager_SelectedIndexChanged"/>
        </Grid>
    </Grid>
</UserControl>

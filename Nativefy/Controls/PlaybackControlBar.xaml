<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nativefy.Controls.PlaybackControlBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Nativefy.Controls"
    xmlns:local="using:Nativefy"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:brushes="using:Nativefy.Brushes" xmlns:system="using:System" xmlns:ic="using:FluentIcons.WinUI"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:TimeSpanTooltipConverter x:Key="TimeSpanTooltipConverter"/>
    </UserControl.Resources>

    <Grid 
        Visibility="Visible" 
        CornerRadius="8"
        Height="70" 
        Padding="5,0" 
        Grid.Row="1"
        VerticalAlignment="Bottom"
        HorizontalAlignment="Stretch"
        ColumnSpacing="20">
        <Grid.Background>
            <brushes:BlurredImageBrush ImageUrl="{x:Bind ViewModel.ImageUrl, Mode=OneWay}" BlurAmount="25"/>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button Click="GoToMediaPlayerPage_Click" Background="Transparent" BorderBrush="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel 
                    Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <Border 
                        Background="Gray"
                        CornerRadius="4">
                        <Image
                            Source="{x:Bind ViewModel.ImageUrl, Mode=OneWay}" 
                            Width="80" Height="60" />
                    </Border>

                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock 
                            Text="{x:Bind ViewModel.ItemTitle, Mode=OneWay}" 
                            ToolTipService.ToolTip="{x:Bind ViewModel.ItemTitle, Mode=OneWay}"
                            FontWeight="SemiBold" 
                            Foreground="White" 
                            FontSize="14"
                            Width="150"
                            TextTrimming="CharacterEllipsis"/>
                        <TextBlock 
                            Text="{x:Bind ViewModel.ChannelName, Mode=OneWay}" 
                            FontSize="11" 
                            Foreground="#B3B3B3" 
                            TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>                
            </Grid>
        </Button>

        <StackPanel
            Orientation="Horizontal"
            Grid.Column="1">
            <Button
                IsEnabled="False"
                ToolTipService.ToolTip="Save to Liked Songs"
                Background="Transparent"
                BorderBrush="Transparent"
                CommandParameter="Save">
                <FontIcon Glyph="&#xEB52;" FontSize="15" />
            </Button>
            <Button
                x:Name="ShuffleButton"
                ToolTipService.ToolTip="Shuffle"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="Shuffle_Click">
                <ic:FluentIcon x:Name="ShuffleIcon" Icon="ArrowShuffleOff" IconVariant="Regular" IconSize="Size20" />
            </Button>
            <Button
                IsEnabled="{x:Bind ViewModel.IsBackwardEnabled, Mode=OneWay}"
                ToolTipService.ToolTip="Backward"
                Background="Transparent"
                BorderBrush="Transparent"
                Command="{x:Bind ViewModel.SkipBackwardCommand, Mode=OneWay}">
                <FontIcon Glyph="&#xE893;" FontSize="20" />
            </Button>
            
            <Button 
                ToolTipService.ToolTip="{x:Bind ViewModel.PlayPauseTooltip, Mode=OneWay}" 
                Background="Transparent" 
                BorderBrush="Transparent" 
                Command="{x:Bind ViewModel.PlayPauseCommand, Mode=OneWay}">
                <FontIcon Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}"  FontSize="20" />
            </Button>
            <Button
                IsEnabled="{x:Bind ViewModel.IsForwardEnabled, Mode=OneWay}"
                ToolTipService.ToolTip="Forward"
                Background="Transparent"
                BorderBrush="Transparent"
                Command="{x:Bind ViewModel.SkipForwardCommand, Mode=OneWay}">
                <FontIcon Glyph="&#xE892;" FontSize="20" />
            </Button>
            <Button
                x:Name="RepeatButton"
                ToolTipService.ToolTip="Repeat Off"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="RepeatButton_Click">
                <ic:FluentIcon x:Name="RepeatIcon" Icon="ArrowRepeatAllOff" IconVariant="Regular" IconSize="Size20" />
            </Button>
        </StackPanel>

        <Grid
            Grid.Column="2"
            VerticalAlignment="Center"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock 
                Text="{x:Bind ViewModel.PositionText, Mode=OneWay}"
                VerticalAlignment="Center"
                Foreground="Gray"/>

            <Slider 
                x:Name="MediaSlider"
                Grid.Column="1"
                Minimum="0"
                Value="{x:Bind ViewModel.Position, Mode=OneWay}"
                Maximum="{x:Bind ViewModel.Duration, Mode=OneWay}"
                HorizontalAlignment="Stretch"
                ThumbToolTipValueConverter="{StaticResource TimeSpanTooltipConverter}"
                ValueChanged="Slider_ValueChanged"
                PointerCaptureLost="Slider_PointerCaptureLost"/>

            <TextBlock 
                Grid.Column="2"
                Text="{x:Bind ViewModel.DurationText, Mode=OneWay}"
                VerticalAlignment="Center"
                Foreground="Gray"/>
        </Grid>
        
        <StackPanel
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Grid.Column="3" Spacing="5">
            <Button 
                ToolTipService.ToolTip="Volume"
                Background="Transparent" 
                Foreground="{ThemeResource SystemAccentColorLight1}"
                BorderThickness="0">
                <FontIcon Glyph="&#xE767;" FontSize="17" />
            </Button>

            <Slider 
                Minimum="0" 
                Maximum="100" 
                Value="50"
                Width="100"
                HorizontalAlignment="Stretch"
                ValueChanged="Volume_ValueChanged"/>

            <ToggleButton 
                ToolTipService.ToolTip="Details"
                Background="Transparent"
                BorderThickness="0"
                IsEnabled="False"
                Command="{x:Bind ViewModel.ToggleDetailsPanelCommand, Mode=OneWay}">
                <FontIcon Glyph="&#xE946;" FontSize="17" />
            </ToggleButton>
        </StackPanel>
    </Grid>
</UserControl>

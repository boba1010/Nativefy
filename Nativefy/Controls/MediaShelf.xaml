<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nativefy.Controls.MediaShelf"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nativefy.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Nativefy.Models"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Grid>
        <Grid 
            Visibility="{x:Bind IsLoading, Mode=OneWay}"
            Margin="0, 24, 0, 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Grid 
                Grid.Row="0" 
                Margin="0,0,0,16">
                <controls:Shimmer
                    Width="100"
                    Height="20"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"/>
                <controls:Shimmer 
                    Width="80"
                    Height="20"
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Center" 
                    Padding="0"/>
            </Grid>
            
            <ItemsRepeater 
                Grid.Row="1"
                ItemsSource="{x:Bind MediaSource, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="16"/>
                </ItemsRepeater.Layout>

                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:MediaCardItem">
                        <Grid>
                            <Grid
                                Grid.Row="1"
                                RowSpacing="10">
                                <controls:Shimmer
                                    Width="230"
                                    Height="300"
                                    Padding="10"
                                    CornerRadius="4"/>

                                <Grid
                                    Grid.Row="1"
                                    RowSpacing="8">
                                    <controls:Shimmer 
                                        Margin="0, 10, 0, 0"
                                        VerticalAlignment="Top"
                                        Width="200" 
                                        Height="180"/>

                                    <StackPanel 
                                        Padding="10"
                                        Spacing="2"
                                        VerticalAlignment="Bottom">
                                        <controls:Shimmer
                                            Width="80"
                                            Height="20"
                                            HorizontalAlignment="Left"/>
                                        <controls:Shimmer
                                            Width="200"
                                            Height="20"
                                            HorizontalAlignment="Left"/>
                                        <controls:Shimmer
                                            Width="120"
                                            Height="15"
                                            HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </Grid>
        
        <Grid
            Visibility="{x:Bind IsNotLoading, Mode=OneWay}"
            Margin="0,24,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <TextBlock 
                    Text="{x:Bind ShelfTitle, Mode=OneWay}" 
                    FontSize="24" 
                    FontWeight="Bold" 
                    Foreground="White" 
                    VerticalAlignment="Center"/>
                <HyperlinkButton 
                    Content="Show all" 
                    Foreground="Gray"
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Center" 
                    Padding="0"
                    Tag="{x:Bind Tag, Mode=OneWay}" />
            </Grid>

            <ScrollView 
                Padding="0, 0, 0, 20"
                Grid.Row="1"
                HorizontalScrollMode="Enabled" 
                VerticalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Visible"
                VerticalScrollBarVisibility="Hidden">

                <ItemsRepeater x:Name="RecentsRepeater" ItemsSource="{x:Bind MediaSource, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="16"/>
                    </ItemsRepeater.Layout>

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:MediaCardItem">
                            <Grid 
                                Width="230"
                                Height="300"
                                Padding="10"
                                CornerRadius="4"
                                PointerEntered="Card_PointerEntered"
                                PointerExited="Card_PointerExited"
                                PointerPressed="Card_PointerPressed">
                                <Grid.Background>
                                    <SolidColorBrush x:Name="CardBackgroundBrush" 
                                        Color="{ThemeResource CardBackgroundFillColorSecondary}"/>
                                </Grid.Background>

                                <Grid RowSpacing="8">
                                    <StackPanel>
                                        <Image 
                                            VerticalAlignment="Top"
                                            Source="{x:Bind ImageUrl}" 
                                            Width="200" 
                                            Height="180"/>
                                        <Grid 
                                            x:Name="hoverOverlay" 
                                            Opacity="0"
                                            CornerRadius="12">

                                            <Button 
                                                Width="48" 
                                                Height="48"
                                                CornerRadius="24"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Background="{ThemeResource SystemAccentColor}"
                                                BorderThickness="0"
                                                Click="OnPlayButtonClick">
                                                <Button.Resources>
                                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemAccentColorDark1}" />
                                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemAccentColorDark2}" />
                                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="Black" />
                                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="Black" />
                                                </Button.Resources>

                                                <FontIcon 
                                                    Glyph="&#xE768;" 
                                                    Foreground="Black" 
                                                    FontSize="16" 
                                                    Margin="2,0,0,0"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel 
                                        Spacing="2"
                                        VerticalAlignment="Bottom">
                                        <TextBlock Text="{x:Bind Title}" 
                                           FontWeight="SemiBold" 
                                           Foreground="White" 
                                           TextTrimming="CharacterEllipsis" 
                                           MaxLines="1"/>
                                        <TextBlock Text="{x:Bind Artist}" 
                                           FontSize="12" 
                                           Foreground="Gray" 
                                           TextTrimming="CharacterEllipsis" 
                                           MaxLines="1"/>
                                        <TextBlock Text="{x:Bind GetSubtitleText()}" 
                                           FontSize="12" 
                                           Foreground="Gray" 
                                           TextTrimming="CharacterEllipsis" 
                                           MaxLines="1"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollView>
        </Grid>        
    </Grid>
</UserControl>

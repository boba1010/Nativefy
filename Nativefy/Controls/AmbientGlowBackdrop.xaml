<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nativefy.Controls.AmbientGlowBackdrop"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nativefy.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Single host Border - the blurred composition visual attaches to this in code-behind.
         This control has no clipping of its own; make sure whatever hosts it (its parent
         Grid) also doesn't clip, or the glow will be cut off the same way it was inside
         the FlipView. -->
    <Border x:Name="GlowHost" Background="Transparent" />
</UserControl>

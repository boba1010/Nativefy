<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nativefy.Controls.HeroSidePane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nativefy.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Grid>
        <Grid
            Visibility="{x:Bind IsLoading, Mode=OneWay}"
            RowSpacing="8"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:Shimmer
                Grid.Row="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>
            <controls:Shimmer
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>
            <controls:Shimmer
                Grid.Row="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>
        </Grid>

        <Grid 
            Visibility="{x:Bind IsNotLoading, Mode=OneWay}"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            RowSpacing="5">

            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button
                Grid.Row="0"
                Padding="0"
                MaxHeight="190"
                CornerRadius="12"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Background="{x:Bind Card0.Accent}"
                Tag="{x:Bind Card0.NavigationUri}"
                Click="OnButtonCLick">
                <Grid>
                    <local:ImageView 
                        ImageUrl="{x:Bind Card0.ImageUri, Mode=OneWay}"
                        Grid.RowSpan="2"/>

                    <Grid Padding="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border 
                            VerticalAlignment="Top"
                            HorizontalAlignment="Left"
                            Padding="3"
                            CornerRadius="4"
                            Background="#4A222222">
                            <TextBlock 
                                HorizontalAlignment="Center"
                                FontSize="11"
                                FontWeight="Bold"
                                Text="{x:Bind Card0.Eyebrow, Mode=OneWay}" />
                        </Border>

                        <TextBlock 
                            Grid.Row="1"
                            VerticalAlignment="Bottom"
                            Text="{x:Bind Card0.Label, Mode=OneWay}"
                            FontSize="20"/>
                    </Grid>
                </Grid>
            </Button>
            <Button
                Grid.Row="1"
                Padding="0"
                MaxHeight="150"
                CornerRadius="12"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Background="{x:Bind Card1.Accent}"
                Tag="{x:Bind Card1.NavigationUri}"
                Click="OnButtonCLick">
                <Grid>
                    <local:ImageView 
                        ImageUrl="{x:Bind Card1.ImageUri, Mode=OneWay}"
                        Grid.RowSpan="2"/>

                    <Grid Padding="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border 
                            VerticalAlignment="Top"
                            HorizontalAlignment="Left"
                            Padding="3"
                            CornerRadius="4"
                            Background="#4A222222">
                            <TextBlock 
                                HorizontalAlignment="Center"
                                FontSize="11"
                                FontWeight="Bold"
                                Text="{x:Bind Card1.Eyebrow, Mode=OneWay}" />
                        </Border>

                        <TextBlock 
                            Grid.Row="1"
                            VerticalAlignment="Bottom"
                            Text="{x:Bind Card1.Label, Mode=OneWay}"
                            FontSize="20"/>
                    </Grid>
                </Grid>
            </Button>
            <Button
                Grid.Row="2"
                Padding="0"
                MaxHeight="150"
                CornerRadius="12"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Background="{x:Bind Card2.Accent}"
                Tag="{x:Bind Card2.NavigationUri}"
                Click="OnButtonCLick">
                <Grid>
                    <local:ImageView 
                        ImageUrl="{x:Bind Card2.ImageUri, Mode=OneWay}"
                        Grid.RowSpan="2"/>

                    <Grid Padding="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border 
                            VerticalAlignment="Top"
                            HorizontalAlignment="Left"
                            Padding="3"
                            CornerRadius="4"
                            Background="#4A222222">
                            <TextBlock 
                                HorizontalAlignment="Center"
                                FontSize="11"
                                FontWeight="Bold"
                                Text="{x:Bind Card2.Eyebrow, Mode=OneWay}" />
                        </Border>

                        <TextBlock 
                            Grid.Row="1"
                            VerticalAlignment="Bottom"
                            Text="{x:Bind Card2.Label, Mode=OneWay}"
                            FontSize="20"/>
                    </Grid>
                </Grid>
            </Button>
        </Grid>        
    </Grid>
</UserControl>

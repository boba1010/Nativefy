<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nativefy.Controls.HeroSidePane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nativefy.Controls"
    xmlns:models="using:Nativefy.Models.Home" 
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <Grid>
        <Grid
            Visibility="{x:Bind IsLoading, Mode=OneWay}"
            RowSpacing="8"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:Shimmer Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <controls:Shimmer Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <controls:Shimmer Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Grid>

        <Grid Visibility="{x:Bind IsNotLoading, Mode=OneWay}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

            <ItemsRepeater ItemsSource="{x:Bind ItemsSource, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="8" />
                </ItemsRepeater.Layout>

                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:SideCardItem">
                        <Button
                            Grid.Row="2" Padding="0"
                            MaxHeight="160" CornerRadius="12"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Tag="{x:Bind Url}"
                            Click="OnButtonCLick">
                            <Grid>
                                <local:ImageView ImageUrl="{x:Bind ImageUrl, Mode=OneWay}" Grid.RowSpan="2" />

                                <Grid Padding="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    
                                    <Border 
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Left"
                                        Padding="3"
                                        CornerRadius="4"
                                        Background="#4A222222">
                                        <TextBlock 
                                            HorizontalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Text="{x:Bind Eyebrow}" />
                                    </Border>

                                    <TextBlock 
                                        Grid.Row="1" FontSize="20"
                                        VerticalAlignment="Bottom"
                                        Text="{x:Bind Title, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"/>
                                    
                                    <TextBlock 
                                        Grid.Row="2" FontSize="14"
                                        VerticalAlignment="Bottom"
                                        Text="{x:Bind Author, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" 
                                        TextWrapping="NoWrap" />
                                </Grid>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </Grid>        
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nativefy.Controls.FeaturedShelf"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nativefy.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:Nativefy.Models"
    mc:Ignorable="d">

    <Grid>
        <Grid 
            HorizontalAlignment="Center"
            Visibility="{x:Bind IsLoading, Mode=OneWay}"
            Margin="0, 24, 0, 0">
            <GridView 
                SelectionMode="None"
                Grid.Row="1"
                ItemsSource="{x:Bind MediaSource, Mode=OneWay}">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="20,10,20,0"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </GridView.ItemContainerStyle>

                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:MediaCardItem">
                        <Grid
                            CornerRadius="12">
                            <Grid
                                Grid.Row="1"
                                RowSpacing="10">
                                <controls:Shimmer
                                    Width="400"
                                    Height="500"
                                    Padding="10"
                                    CornerRadius="4"/>

                                <Grid
                                    Grid.Row="1"
                                    RowSpacing="8">
                                    <controls:Shimmer 
                                        Margin="20, 20, 0, 0"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Left"
                                        Width="100" 
                                        Height="100"/>

                                    <StackPanel 
                                        Padding="10"
                                        Spacing="2"
                                        VerticalAlignment="Bottom">
                                        <controls:Shimmer
                                            Width="80"
                                            Height="20"
                                            HorizontalAlignment="Left"/>
                                        <controls:Shimmer
                                            Width="200"
                                            Height="20"
                                            HorizontalAlignment="Left"/>
                                        <controls:Shimmer
                                            Width="120"
                                            Height="15"
                                            HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>

        <Grid
            HorizontalAlignment="Center"
            Visibility="{x:Bind IsNotLoading, Mode=OneWay}"
            Margin="0,24,0,0">
            <GridView 
                SelectionMode="None"
                ItemsSource="{x:Bind MediaSource, Mode=OneWay}">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="10,10,10,0"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </GridView.ItemContainerStyle>

                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:MediaCardItem">
                        <Grid 
                            Width="330"
                            Height="500"
                            Padding="10"
                            CornerRadius="12"
                            PointerEntered="Card_PointerEntered"
                            PointerExited="Card_PointerExited"
                            PointerPressed="Card_PointerPressed">
                            <Grid.Background>
                                <SolidColorBrush x:Name="CardBackgroundBrush" 
                                    Color="{ThemeResource CardBackgroundFillColorSecondary}"/>
                            </Grid.Background>

                            <StackPanel Orientation="Horizontal">
                                <Image 
                                    Margin="10, 10, 0, 0"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Left"
                                    Width="100" 
                                    Height="100"
                                    Source="{x:Bind ImageUrl}" />

                                <StackPanel 
                                    Spacing="2"
                                    Margin="10, 10, 0, 0"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Left">
                                    <TextBlock 
                                        Text="{x:Bind Title}" 
                                        FontWeight="SemiBold" 
                                        Foreground="White" 
                                        TextTrimming="CharacterEllipsis" 
                                        MaxLines="1"/>
                                    <TextBlock 
                                        Text="{x:Bind Artist}" 
                                        FontSize="12" 
                                        Foreground="Gray" 
                                        TextTrimming="CharacterEllipsis" 
                                        MaxLines="1"/>
                                    <TextBlock 
                                        Text="{x:Bind GetSubtitleText()}" 
                                        FontSize="12" 
                                        Foreground="Gray" 
                                        TextTrimming="CharacterEllipsis" 
                                        MaxLines="1"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid 
                                x:Name="hoverOverlay" 
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Opacity="0"
                                CornerRadius="12"
                                ColumnSpacing="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <Button 
                                    Grid.Column="2"
                                    Width="48" 
                                    Height="48"
                                    CornerRadius="24"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SystemAccentColor}"
                                    BorderThickness="0"
                                    Click="OnPlayButtonClick">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemAccentColorDark1}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemAccentColorDark2}" />
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="Black" />
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="Black" />
                                    </Button.Resources>

                                    <FontIcon 
                                        Glyph="&#xE768;" 
                                        Foreground="Black" 
                                        FontSize="16" 
                                        Margin="2,0,0,0"/>
                                </Button>
                                <Button 
                                    Grid.Column="1"
                                    Padding="0"
                                    Width="40" 
                                    Height="40"
                                    CornerRadius="20"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemAccentColorDark1}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemAccentColorDark2}" />
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="Black" />
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="Black" />
                                    </Button.Resources>

                                    <FontIcon 
                                        Glyph="&#xE710;" 
                                        Foreground="White" 
                                        FontSize="16" 
                                        Margin="2,0,0,0"/>
                                </Button>

                                <Button 
                                    Padding="0"
                                    Width="100" 
                                    Height="30"
                                    CornerRadius="12"
                                    VerticalAlignment="Center"
                                    Background="#2A000000"
                                    BorderThickness="0">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#3A000000" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#19000000" />
                                    </Button.Resources>

                                    <StackPanel 
                                        Spacing="4"
                                        Orientation="Horizontal">
                                        <TextBlock 
                                            Text="Preview"
                                            Foreground="Gray"/>

                                        <FontIcon 
                                            Glyph="&#xE74F;" 
                                            Foreground="Gray" 
                                            FontSize="15"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nativefy.Controls.ChannelVideosView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nativefy.Controls" 
    xmlns:models="using:Nativefy.Models.Media" 
    xmlns:helpers="using:Nativefy.Helpers" 
    xmlns:convertors="using:Nativefy.Convertors">

    <UserControl.Resources>
        <convertors:VideosTabConvertor x:Name="VideosTabConvertor" />
    </UserControl.Resources>

    <ItemsRepeater 
        HorizontalAlignment="Center"
        Visibility="{x:Bind Tab, Mode=OneWay, Converter={StaticResource VideosTabConvertor}}" 
        ItemsSource="{x:Bind Videos, Mode=OneWay}">
        <ItemsRepeater.Layout>
            <UniformGridLayout
                Orientation="Horizontal"
                MinItemWidth="350"
                MinItemHeight="270"
                MinColumnSpacing="8"
                MinRowSpacing="8" />
        </ItemsRepeater.Layout>

        <DataTemplate x:DataType="models:MediaItem">
            <Button 
                Width="350" Height="270"
                VerticalAlignment="Stretch" 
                HorizontalAlignment="Stretch" 
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Tag="{x:Bind Id}" Padding="10"
                Click="Play_Clicked">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="191" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid VerticalAlignment="Stretch">
                        <Border>
                            <Image
                                Stretch="UniformToFill" 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" 
                                Source="{x:Bind ImageUrl}" />
                        </Border>

                        <Border 
                            VerticalAlignment="Bottom" 
                            HorizontalAlignment="Left" 
                            Background="Black"
                            Margin="5"
                            Padding="2, 0" CornerRadius="4">
                            <TextBlock Text="{x:Bind helpers:DurationHelper.FormatDuration(Duration)}" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1" Spacing="2">
                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" FontSize="16" />
                        <TextBlock Text="{x:Bind Author}" FontSize="14" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </ItemsRepeater>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Nativefy.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nativefy"
    xmlns:models="using:Nativefy.Models"
    xmlns:controls="using:Nativefy.Controls"
    Title="Nativefy">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar
            Padding="5"
            VerticalAlignment="Top"
            IsBackButtonVisible="True"
            IsBackButtonEnabled="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnPaneToggleRequested"
            BackRequested="Titlebar_BackRequested"
            Canvas.ZIndex="999"
            x:Name="Titlebar">

            <TitleBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button
                        VerticalAlignment="Stretch"
                        BorderThickness="0"
                        Background="Transparent"
                        Click="OnHomeButtonClick">
                        <Button.Content>
                            <FontIcon Glyph="&#xE80F;"/>
                        </Button.Content>
                    </Button>

                    <AutoSuggestBox 
                        BorderBrush="Transparent"
                        BorderThickness="0" Width="400"
                        Height="35" QueryIcon="Find"
                        QuerySubmitted="Searchbox_QuerySubmitted"
                        VerticalContentAlignment="Center"
                        PlaceholderText="What do you want to play?">
                        <AutoSuggestBox.Resources>
                            <ResourceDictionary>
                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>

                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource SystemAccentColor}"/>

                                <Thickness x:Key="TextControlThemePadding">14,6,36,6</Thickness>
                                <CornerRadius x:Key="AutoSuggestBoxControlCornerRadius">20</CornerRadius>
                            </ResourceDictionary>
                        </AutoSuggestBox.Resources>
                    </AutoSuggestBox>
                </StackPanel>
            </TitleBar.Content>

            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                    <Button Background="Transparent" BorderBrush="Transparent" Padding="5, 8" Width="40" HorizontalContentAlignment="Stretch">
                        <Grid>
                            <FontIcon Glyph="&#xEA8F;" />
                            <InfoBadge Value="{x:Bind ViewModel.NotificationCount, Mode=OneWay}" Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>

                        <Button.Flyout>
                            <Flyout Placement="Bottom" Opened="NotificationsCenter_Opened">
                                <Flyout.SystemBackdrop>
                                    <MicaBackdrop />
                                </Flyout.SystemBackdrop>
                                
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Notifications"/>

                                    <ScrollViewer MaxHeight="400" MinWidth="400" VerticalScrollBarVisibility="Auto">
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Notifications, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="8" />
                                            </ItemsRepeater.Layout>

                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="models:Notification">
                                                    <Grid Padding="12" ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <FontIcon 
                                                            Glyph="{x:Bind local:Converters.SeverityToGlyph(Severity), Mode=OneWay}" 
                                                            VerticalAlignment="Top" />

                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                                            <TextBlock 
                                                                Visibility="{x:Bind local:Converters.NullToVisibility(Message), Mode=OneWay}" 
                                                                Text="{x:Bind Message, Mode=OneWay}"
                                                                MinHeight="0" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </ScrollViewer>                                    
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <AppBarSeparator />

                    <AppBarButton Width="40" Click="Settings_Click">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Setting" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarToggleButton Width="40" IsChecked="{x:Bind ViewModel.IsPlayerbarVisible, Mode=TwoWay}">
                        <AppBarToggleButton.Icon>
                            <SymbolIcon Symbol="DockBottom" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    
                    <AppBarToggleButton Width="40" Click="ToggleFullscreen_Click">
                        <AppBarToggleButton.Icon>
                            <SymbolIcon Symbol="FullScreen" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <controls:LibraryNavigationView
            x:Name="MainNavView"
            OpenPaneLength="300"
            Grid.Row="1"
            IsPaneOpen="True"
            ItemInvoked="OnItemInvoked"
            AddCommand="{x:Bind AddPlaylistCommand}">

            <controls:LibraryNavigationView.InnerContent>
                <Frame x:Name="ContentFrame" CacheSize="1" Loading="ContentFrame_Loading"/>
            </controls:LibraryNavigationView.InnerContent>
        </controls:LibraryNavigationView>

        <controls:PlaybackControlBar Visibility="{x:Bind ViewModel.IsPlayerbarVisible, Mode=OneWay}" x:Name="PlaybackBar" Grid.Row="2"/>
    </Grid>
</Window>
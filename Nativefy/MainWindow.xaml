<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Nativefy.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nativefy"
    xmlns:models="using:Nativefy.Models"
    xmlns:controls="using:Nativefy.Controls"
    Title="Nativefy">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar
            Padding="5"
            IsBackButtonVisible="True"
            IsBackButtonEnabled="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnPaneToggleRequested"
            BackRequested="Titlebar_BackRequested"
            x:Name="Titlebar">

            <TitleBar.Content>
                <StackPanel
                    Orientation="Horizontal" 
                    Spacing="10">
                    <Button
                        VerticalAlignment="Stretch"
                        BorderThickness="0"
                        Background="Transparent"
                        Click="OnHomeButtonClick">
                        <Button.Content>
                            <FontIcon Glyph="&#xE80F;"/>
                        </Button.Content>
                    </Button>

                    <AutoSuggestBox 
                        BorderBrush="Transparent"
                        BorderThickness="0" Width="400"
                        Height="35" QueryIcon="Find"
                        QuerySubmitted="Searchbox_QuerySubmitted"
                        VerticalContentAlignment="Center"
                        PlaceholderText="What do you want to play?">
                        <AutoSuggestBox.Resources>
                            <ResourceDictionary>
                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>

                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource SystemAccentColor}"/>

                                <Thickness x:Key="TextControlThemePadding">14,6,36,6</Thickness>
                                <CornerRadius x:Key="AutoSuggestBoxControlCornerRadius">20</CornerRadius>
                            </ResourceDictionary>
                        </AutoSuggestBox.Resources>
                    </AutoSuggestBox>
                </StackPanel>
            </TitleBar.Content>

            <TitleBar.RightHeader>
                <StackPanel 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Spacing="4">
                    <AppBarButton Width="40">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xEA8F;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarSeparator />

                    <AppBarButton Width="40">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Setting" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarToggleButton Width="40">
                        <AppBarToggleButton.Icon>
                            <FontIcon Glyph="&#xe90d;" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <controls:LibraryNavigationView
            x:Name="MainNavView"
            OpenPaneLength="300"
            Grid.Row="1"
            IsPaneOpen="True"
            ItemInvoked="OnItemInvoked"
            AddCommand="{x:Bind AddCommand}">

            <controls:LibraryNavigationView.InnerContent>
                <Frame x:Name="ContentFrame" CacheSize="1" Loading="ContentFrame_Loading"/>
            </controls:LibraryNavigationView.InnerContent>
        </controls:LibraryNavigationView>

        <controls:PlaybackControlBar x:Name="PlaybackBar" Grid.Row="2"/>
    </Grid>
</Window>